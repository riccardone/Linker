<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Linker.KurrentDB</PackageId>
    <Title>Data Replication for KurrentDb</Title>
    <Description>Replicate data between KurrentDb (former EventStore) instances</Description>
    <Copyright>@2025 Riccardo Di Nuzzo</Copyright>
    <PackageProjectUrl>https://github.com/riccardone/Linker</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/riccardone/Linker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>KurrentDb; EventSourcing; Replication</PackageTags>
    <PackageReleaseNotes>Published as Linker.KurrentDB (the Linker.Core id on nuget.org belongs to another owner); the namespace is still Linker.Core.
Batched, parallel appends during catch-up; resubscribes when the $all subscription drops.
The replication checkpoint is saved only once every stream in a drain cycle has been written.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EventStore.Tools.PositionRepository.Gprc" Version="1.4.3" />
  </ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
   </ItemGroup>

</Project>
